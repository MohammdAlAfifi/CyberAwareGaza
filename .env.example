# Runtime queries: copy the Supabase Shared Pooler transaction-mode URL.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres

# Migrations/backups: copy the Supabase direct connection URL. Never guess its host.
DIRECT_DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres

# Generate at least 32 random bytes; do not reuse between preview and production.
SESSION_SECRET=replace-with-a-long-random-secret

# Comma-separated trusted origins for cookie-authenticated mutations.
APP_ORIGINS=http://localhost:3000

APP_TIMEZONE=Asia/Hebron
ANONYMOUS_SESSION_HOURS=24
REGISTERED_SESSION_DAYS=30
