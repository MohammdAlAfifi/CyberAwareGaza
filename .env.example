# Runtime queries: copy the exact Supabase Shared Pooler transaction-mode URL.
# This value is server-only. Never prefix it with NEXT_PUBLIC_.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@POOLER_HOST:6543/postgres

# Controlled migrations, seed, checks, and backups: copy the exact direct URL.
# If the machine cannot reach IPv6, use the Supabase session-pooler URL instead.
DIRECT_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres

# Optional for local Node.js clients when the Supabase CA is not in the system
# trust store. Use the full path to the certificate file, not its directory.
# SUPABASE_CA_CERT_PATH=C:\full\path\to\prod-ca-2021.crt

# Generate at least 32 random bytes; do not reuse between preview and production.
SESSION_SECRET=replace-me

# Comma-separated trusted origins for cookie-authenticated mutations.
APP_ORIGINS=http://localhost:3000

APP_TIMEZONE=Asia/Hebron
ANONYMOUS_SESSION_HOURS=24
REGISTERED_SESSION_DAYS=30

# Private admin provisioning reads these only from the invoking shell. Do not
# save a real admin password in this file or commit it.
# ADMIN_USERNAME=research-admin
# ADMIN_DISPLAY_NAME=Research administrator
# ADMIN_PASSWORD=set-this-in-the-current-shell-only
