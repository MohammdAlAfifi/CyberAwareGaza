{
  "name": "cyberawaregaza",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:auth": "node --env-file-if-exists=.env.local node_modules/@playwright/test/cli.js test e2e/phase3-auth.spec.ts",
    "test:e2e:assessment": "node --env-file-if-exists=.env.local node_modules/@playwright/test/cli.js test e2e/phase4-assessment.spec.ts",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate-database.mjs",
    "db:seed": "node --env-file-if-exists=.env.local scripts/seed-foundation.mjs",
    "db:check": "node --env-file-if-exists=.env.local scripts/check-database.mjs",
    "db:provision-admin": "node --env-file-if-exists=.env.local scripts/provision-admin.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/noto-sans-arabic": "^5.3.0",
    "@node-rs/argon2": "2.2.1",
    "drizzle-orm": "0.45.3",
    "next": "16.3.6",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.3",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "vitest": "5.0.2"
  }
}
